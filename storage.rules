rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function memberDoc() { return firestore.get(/databases/(default)/documents/members/$(request.auth.uid)); }
    function approved() { return signedIn() && memberDoc().data.status == 'approved'; }

    match /chat-images/{roomId}/{uid}/{fileName} {
      allow read: if approved();
      allow create: if approved()
        && request.auth.uid == uid
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
